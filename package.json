{
  "name": "bloglist",
  "version": "1.0.0",
  "license": "ISC",
  "author": "Hiwersen Angelo",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node index.js",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1",
    "dev": "cross-env NODE_ENV=development nodemon --inspect index.js",
    "build:ui": "rm -rf dist && cd ./frontend/ && npm run build && cp -r dist ../",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0"
  }
}
